# Server-only Intui preview variables. Defaults MUST remain OFF.
# Do not commit real credentials; .env.local is ignored by Git.
# Set real values in your hosting provider's secret/environment configuration.
#
# GitHub Actions secrets do NOT automatically exist in Cloud Run or other hosts.
# Before enabling on public infrastructure also set up shared/WAF rate limiting
# and an access control layer covering BOTH the preview route and Start server functions.

INTUI_PREVIEW_ENABLED=false
INTUI_LIVE_ENABLED=false
INTUI_API_KEY=
INTUI_PREVIEW_ACCESS_PASSWORD=
INTUI_PREVIEW_SESSION_SECRET=

# Isolated Alps2Alps / Amitours B2B API v2 SANDBOX (not production).
# Credentials are set as server-only hosting secrets, NEVER VITE_*.
# Even with credentials present, the preview stays disabled until opted in.
# Reuses INTUI_PREVIEW_ACCESS_PASSWORD / INTUI_PREVIEW_SESSION_SECRET for
# its separate private cookie, so no new preview password is needed.
ALPS2ALPS_SANDBOX_PREVIEW_ENABLED=false
ALPS2ALPS_SANDBOX_API_KEY=
ALPS2ALPS_SANDBOX_API_SECRET=

# Isolated GetTransfer read-only sandbox preview (gtrbox.org GET /api/route_info only).
# Reuses the Intui private preview password and signing secret; never uses VITE_*.
# The GETTRANSFER_SANDBOX_TOKEN must be a server-side secret.
GETTRANSFER_SANDBOX_PREVIEW_ENABLED=false
GETTRANSFER_SANDBOX_TOKEN=

# Transferise private sandbox preview. Same existing preview login; no VITE_*.
# Only tfx_test_ keys are accepted. No live requests, booking writes or payments.
TRANSFERISE_SANDBOX_PREVIEW_ENABLED=false
TRANSFERISE_SANDBOX_API_KEY=

