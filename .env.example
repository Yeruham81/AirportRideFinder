# Server-only Intui preview variables. Defaults MUST remain OFF.
# Do not commit real credentials; .env.local is ignored by Git.
# Set real values in your hosting provider's secret/environment configuration.
#
# GitHub Actions secrets do NOT automatically exist in Cloud Run or other hosts.
# Before enabling on public infrastructure also set up shared/WAF rate limiting
# and an access control layer covering BOTH the preview route and Start server functions.

INTUI_PREVIEW_ENABLED=false
INTUI_LIVE_ENABLED=false
INTUI_API_KEY=
INTUI_PREVIEW_ACCESS_PASSWORD=
INTUI_PREVIEW_SESSION_SECRET=
